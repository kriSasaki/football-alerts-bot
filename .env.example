# ─── Telegram Bot ───────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_ENABLED=1
ALLOW_WEB_ONLY_FALLBACK=1
TELEGRAM_PROXY=
TELEGRAM_BASE_URL=
APP_NAME=Pulse Alerts

# ─── SofaScore (no API key needed!) ─────────────────
SOFASCORE_MIN_INTERVAL=0.75

# ─── Polling ────────────────────────────────────────
POLL_INTERVAL=15

# ─── Cache TTL ──────────────────────────────────────
LIVE_CACHE_TTL=10
EVENT_CACHE_TTL=20
STATS_CACHE_TTL=10
SCHEDULE_CACHE_TTL=300
KICKOFF_LOOKAROUND_SECONDS=900

# ─── Match start tolerance (seconds) ───────────────
MATCH_START_TOLERANCE=3600

# ─── Database ───────────────────────────────────────
DATABASE_PATH=alerts.db

# ─── Authorization ──────────────────────────────────
# Comma-separated Telegram user IDs of admins (can approve/reject users)
ADMIN_USERS=
# Comma-separated Telegram user IDs with instant access (optional)
# If both ADMIN_USERS and AUTHORIZED_USERS are empty — bot is open to everyone
AUTHORIZED_USERS=
# File to persist approved users
APPROVED_USERS_FILE=approved_users.json

# ─── Web Push / PWA ──────────────────────────────────
WEB_APP_ENABLED=1
WEB_APP_HOST=0.0.0.0
WEB_APP_PORT=8080
WEB_APP_PORT_MAX_TRIES=10
WEB_APP_PUBLIC_URL=http://localhost:8080
WEB_AUTH_TTL_SECONDS=2592000
WEB_AUTH_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
