# ─── Telegram Bot ───────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ─── SofaScore (no API key needed!) ─────────────────
SOFASCORE_MIN_INTERVAL=1.5

# ─── Polling ────────────────────────────────────────
POLL_INTERVAL=120

# ─── Cache TTL ──────────────────────────────────────
LIVE_CACHE_TTL=60
SCHEDULE_CACHE_TTL=300

# ─── Match start tolerance (seconds) ───────────────
MATCH_START_TOLERANCE=3600

# ─── Database ───────────────────────────────────────
DATABASE_PATH=alerts.db

# ─── Authorization ──────────────────────────────────
# Comma-separated Telegram user IDs of admins (can approve/reject users)
ADMIN_USERS=
# Comma-separated Telegram user IDs with instant access (optional)
# If both ADMIN_USERS and AUTHORIZED_USERS are empty — bot is open to everyone
AUTHORIZED_USERS=
# File to persist approved users
APPROVED_USERS_FILE=approved_users.json
